# Copy to `.env` and fill in real values. Never commit `.env`.
# Full reference: docs/CONFIGURATION.md

# -----------------------------------------------------------------------------
# Public origin (exact match for BFF Origin / CSRF / __Host- cookies)
# -----------------------------------------------------------------------------
SDK_AUTH_PUBLIC_ORIGIN=https://app.example.com

# -----------------------------------------------------------------------------
# Persistence (production)
# Prefer secret manager injection over shell history for credentials.
# Do not pass passwords on the command line when using migrate tools.
# -----------------------------------------------------------------------------
SDK_AUTH_POSTGRES_URL=postgres://sdk_auth:change-me@127.0.0.1:5432/sdk_auth
SDK_AUTH_REDIS_URL=redis://127.0.0.1:6379/0

# Optional single-process SQLite path for local dev
# SDK_AUTH_SQLITE_PATH=./auth.db

# -----------------------------------------------------------------------------
# Integration tests (optional; used by CI / cargo tests when set)
# -----------------------------------------------------------------------------
SDK_AUTH_TEST_POSTGRES_URL=postgres://sdk_auth:sdk_auth_test@127.0.0.1:5432/sdk_auth
SDK_AUTH_TEST_REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# OAuth / OIDC providers (server-side only — never expose as VITE_* or browser env)
# Callback URLs must match provider console + BFF routes exactly.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=consumers

# -----------------------------------------------------------------------------
# Cryptographic material (32-byte keys). Load from a secret manager at runtime.
# Generate: openssl rand -base64 32
# Never store vault / BFF keys in SQLite, Postgres, or Redis payloads.
# Uncomment and set only in local `.env` — keep commented in this example.
# -----------------------------------------------------------------------------
# SDK_AUTH_VAULT_KEY_B64=
# SDK_AUTH_VAULT_KEY_ID=auth-v1
# SDK_AUTH_BFF_KEY_B64=
# SDK_AUTH_BFF_KEY_ID=bff-2026-08
# SDK_AUTH_REDIS_PRIVACY_KEY_B64=
